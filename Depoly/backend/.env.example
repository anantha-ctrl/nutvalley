# ─────────────────────────────────────────────────────────────
#  NutValley backend — local config / secrets   (backend/.env)
#
#  IDHU THAAN ellaa API key / SMTP / secret update pannura ORE file.
#  Inga key-ku value kudutha adhu code default-a override pannum.
#  Value kudukkalaina (empty vitta) code-la irukkura default velaya seyyum.
#
#  ⚠️  Idhu git-la commit pannakoodathu (.gitignore-la already iruku).
#  Edit panna aprom Apache-a restart pannunga (XAMPP → Stop/Start Apache).
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost/NutsVally/backend
FRONTEND_URL=http://localhost:5181

# ── Database (cloudfashion DB) ───────────────────────────────
#   Unga MySQL root password-a DB_PASS-la podunga.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloudfashion
DB_USER=root
DB_PASS=your-mysql-password

# ── JWT (login token secret) ─────────────────────────────────
#   Production-la ORU neduvana random string podunga (security).
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=86400

# ── Mail / SMTP  (OTP, order emails, password reset) ─────────
#   MAIL_DRIVER=log   → email anuppaadhu, backend/storage/mail.log-la ezhudhum
#                       (local test-ku ideal — OTP-a log file-la paakkalam)
#   MAIL_DRIVER=smtp  → real email anuppum (kீழ SMTP_USER/PASS fill pannanum)
#
#   Gmail use panna:
#     1. Google Account → Security → 2-Step Verification ON pannunga
#     2. "App passwords" → pudhu app password generate pannunga (16 char)
#     3. Andha 16-char password-a SMTP_PASS-la podunga (normal Gmail password ILLA)
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourstore@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=yourstore@gmail.com
MAIL_FROM_NAME=NutValley

# ── Cloudinary  (product image upload / hosting) ─────────────
#   Illaina admin-la upload panna image data-URI-a DB-la store aagum (chinnadhukku OK).
#   Get keys: https://cloudinary.com  → Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=zwwtez5o
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Cron key  (Mail Automation runner) ───────────────────────
#   Windows Task Scheduler / cron idha vachu email drip-a anuppum:
#     curl "http://localhost/NutsVally/backend/api/cron/run?key=YOUR_CRON_KEY"
#   Empty vitta cron endpoint disable — Admin → Automation "Run now" use pannunga.
CRON_KEY=change-me

# ── Razorpay  (payment gateway) ──────────────────────────────
#   Get keys: https://dashboard.razorpay.com → Settings → API Keys → Generate
#   Test keys  → rzp_test_...   (mudhalla idhula trial pannunga)
#   Live keys  → rzp_live_...   (real money — KYC approve aana pinnadi thaan varum)
#   Rendaiyum empty vitta checkout test-mode-la velaya seyyum (order aagum, charge aagaadhu).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── Delivery partner (courier API) ───────────────────────────
#   Inga value kudutha adhu Admin panel value-a OVERRIDE pannum
#   (Admin → Delivery → Courier account-la andha field lock aagi kaanum).
#   Empty vitta / line-a delete panna → Admin panel-la irundhu manage pannalam.
#   Edit panna aprom Apache-a restart pannunga.
#
#   Provider: ithink / shiprocket / delhivery / none
DELIVERY_PROVIDER=
#
#   iThink Logistics   → panel: Settings → API
#     DELIVERY_API_KEY    = access_token
#     DELIVERY_API_SECRET = secret_key
#   Shiprocket         → Settings → API → Configure (thani API user create pannunga)
#     DELIVERY_EMAIL      = API user email
#     DELIVERY_API_SECRET = API user password
#   Delhivery (direct) → Delhivery One → Settings → API Setup
#     DELIVERY_API_KEY    = API token
DELIVERY_API_KEY=
DELIVERY_API_SECRET=
DELIVERY_EMAIL=

#   Pickup / warehouse — courier account-la irukkura name-oda EXACT match aaganum
DELIVERY_PICKUP_LOCATION=
DELIVERY_PICKUP_PINCODE=
#   iThink warehouse / return address id (optional)
DELIVERY_CHANNEL_ID=

#   1 = order "packed" aana odane AWB auto-book aagum. 0 = kaiyala "Book shipment".
DELIVERY_AUTO_SHIP=
#   1 = iThink staging endpoint (test only — real parcel create aagaadhu)
DELIVERY_SANDBOX=

#   Default parcel — weight kg per item, length/breadth/height cm
DELIVERY_DEFAULT_WEIGHT=
DELIVERY_DEFAULT_LENGTH=
DELIVERY_DEFAULT_BREADTH=
DELIVERY_DEFAULT_HEIGHT=
