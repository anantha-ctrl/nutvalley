# ─────────────────────────────────────────────────────────────
#  NutValley — app folder hardening
#  Only the app's public entry points should be reachable over HTTP.
#  Secrets, source, logs, DB dumps and dot-files are blocked.
# ─────────────────────────────────────────────────────────────

# No directory browsing (don't list files if there's no index)
Options -Indexes

# Block every dot-file: .env  .git  .htaccess  .gitignore …
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive file types anywhere under this app
<FilesMatch "\.(env|log|sql|md|example|ini|lock|json|sh|bat)$">
    Require all denied
</FilesMatch>

# package.json / composer.json etc. are covered by the .json rule above.
# The React build (frontend/dist) and API (backend/index.php) still work.

# ── React SPA fallback ──
# React Router handles /category/almonds, /product/x, /admin … in the browser.
# On refresh the server must return index.html for any path that isn't a
# real file or folder, otherwise LiteSpeed/Apache answers 404.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Leave the PHP API alone (backend/ has its own front controller)
    RewriteRule ^backend(/|$) - [L]

    # Real files / folders are served as-is (assets, images, icons…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → the SPA entry point
    RewriteRule ^ index.html [L]
</IfModule>
